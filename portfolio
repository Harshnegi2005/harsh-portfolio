    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700;800&display=swap" rel="stylesheet">
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <style>
        /* Default Dark Theme Variables */
        :root {
            --bg-color: #08090c;
            --card-bg: rgba(31, 40, 51, 0.6);
            --card-border: rgba(255, 87, 34, 0.2);
            --accent-orange: #ff5722;
            --accent-glow: #ff7043;
            --text-main: #ffffff;
            --text-secondary: #c5c6c7;
            --border-color: #222831;
            --nav-bg: rgba(8, 9, 12, 0.85);
            --table-header-bg: #10141a;
        }

        /* Light Theme Override Variables */
        body.light-theme {
            --bg-color: #f8f9fa;
            --card-bg: rgba(255, 255, 255, 0.85);
            --card-border: rgba(255, 87, 34, 0.3);
            --accent-orange: #e64a19;
            --accent-glow: #ff5722;
            --text-main: #1a1a1a;
            --text-secondary: #4a5568;
            --border-color: #e2e8f0;
            --nav-bg: rgba(255, 255, 255, 0.9);
            --table-header-bg: #edf2f7;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Inter', sans-serif;
            scroll-behavior: smooth;
        }

        body {
            background-color: var(--bg-color);
            color: var(--text-main);
            line-height: 1.6;
            overflow-x: hidden;
            position: relative;
            transition: background-color 0.4s ease, color 0.4s ease;
        }

        /* Fire Sparkle Canvas */
        #sparkle-canvas {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            pointer-events: none;
            z-index: 9999;
        }

        /* Scrollbar Styling */
        ::-webkit-scrollbar {
            width: 8px;
        }
        ::-webkit-scrollbar-track {
            background: var(--bg-color);
        }
        ::-webkit-scrollbar-thumb {
            background: #2a2d34;
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: var(--accent-orange);
        }

        /* Typography Helper */
        h1, h2, h3, h4 {
            color: var(--text-main);
            font-weight: 700;
        }

        a {
            text-decoration: none;
            color: var(--accent-orange);
            transition: 0.3s;
        }

        a:hover {
            opacity: 0.8;
        }

        /* Layout & Containers */
        .container {
            width: 90%;
            max-width: 1200px;
            margin: auto;
            padding: 70px 0;
        }

        section {
            border-bottom: 1px solid var(--border-color);
            position: relative;
        }

        .section-header {
            text-align: center;
            margin-bottom: 45px;
        }

        .section-header span {
            color: var(--accent-orange);
            font-weight: 600;
            text-transform: uppercase;
            font-size: 0.9rem;
            letter-spacing: 3px;
            display: inline-block;
            margin-bottom: 5px;
        }

        .section-header h2 {
            font-size: 2.3rem;
            letter-spacing: -0.5px;
            color: var(--text-main);
        }

        /* Navigation */
        nav {
            position: fixed;
            top: 0;
            width: 100%;
            background: var(--nav-bg);
            backdrop-filter: blur(12px);
            border-bottom: 1px solid var(--border-color);
            z-index: 1000;
            padding: 18px 0;
            transition: background 0.4s ease;
        }

        .nav-container {
            display: flex;
            justify-content: space-between;
            align-items: center;
            width: 90%;
            max-width: 1200px;
            margin: auto;
        }

        .logo {
            font-size: 1.4rem;
            font-weight: 800;
            color: var(--text-main);
            letter-spacing: 1px;
        }

        .logo span {
            color: var(--accent-orange);
        }

        .nav-right-group {
            display: flex;
            align-items: center;
            gap: 20px;
        }

        .nav-links {
            display: flex;
            list-style: none;
            gap: 25px;
        }

        .nav-links a {
            color: var(--text-secondary);
            font-size: 0.95rem;
            font-weight: 500;
            position: relative;
        }

        .nav-links a::after {
            content: '';
            position: absolute;
            bottom: -5px;
            left: 0;
            width: 0%;
            height: 2px;
            background: var(--accent-orange);
            transition: 0.3s;
        }

        .nav-links a:hover {
            color: var(--text-main);
        }

        .nav-links a:hover::after {
            width: 100%;
        }

        /* Dark / Light Toggle Button Styling */
        .theme-toggle-btn {
            background: var(--card-bg);
            border: 1px solid var(--card-border);
            color: var(--text-main);
            padding: 8px 14px;
            border-radius: 20px;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 0.9rem;
            font-weight: 600;
            transition: all 0.3s ease;
        }

        .theme-toggle-btn:hover {
            border-color: var(--accent-orange);
            transform: scale(1.05);
        }

        /* Pop-Up Slide Animation Classes */
        .reveal-pop {
            opacity: 0;
            transform: translateY(40px) scale(0.95);
            transition: all 0.7s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            will-change: transform, opacity;
        }

        .reveal-pop.active {
            opacity: 1;
            transform: translateY(0) scale(1);
        }

        /* Hero Section */
        #hero {
            min-height: 100vh;
            display: flex;
            align-items: center;
            padding-top: 80px;
            background: radial-gradient(circle at 10% 20%, rgba(255, 87, 34, 0.08) 0%, transparent 40%);
        }

        .hero-grid {
            display: grid;
            grid-template-columns: 1.2fr 0.8fr;
            gap: 50px;
            align-items: center;
        }

        .hero-text h1 {
            font-size: 3.8rem;
            line-height: 1.1;
            margin-bottom: 12px;
            letter-spacing: -1px;
        }

        .hero-text .subtitle {
            font-size: 1.3rem;
            color: var(--accent-orange);
            font-weight: 600;
            margin-bottom: 18px;
        }

        .hero-text p {
            color: var(--text-secondary);
            margin-bottom: 25px;
            font-size: 1.05rem;
        }

        .tag-list {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            margin-bottom: 35px;
        }

        .tag {
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid var(--card-border);
            padding: 8px 16px;
            border-radius: 30px;
            font-size: 0.85rem;
            color: var(--text-secondary);
            transition: 0.3s;
        }

        .tag:hover {
            border-color: var(--accent-orange);
            color: var(--text-main);
            transform: translateY(-2px);
        }

        .hero-image {
            text-align: center;
            position: relative;
        }

        .hero-image img {
            width: 290px;
            height: 290px;
            border-radius: 50%;
            border: 3px solid var(--accent-orange);
            object-fit: cover;
            box-shadow: 0 0 30px rgba(255, 87, 34, 0.3);
            animation: floatImage 4s ease-in-out infinite;
        }

        @keyframes floatImage {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-12px); }
        }

        /* Cards & Grid Styling */
        .grid-2 { display: grid; grid-template-columns: repeat(2, 1fr); gap: 25px; }
        .grid-3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 25px; }
        .grid-4 { display: grid; grid-template-columns: repeat(4, 1fr); gap: 25px; }

        .card {
            background: var(--card-bg);
            backdrop-filter: blur(8px);
            border: 1px solid var(--border-color);
            padding: 30px;
            border-radius: 14px;
            transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
            position: relative;
            overflow: hidden;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
        }

        .card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: radial-gradient(600px circle at var(--mouse-x, 50%) var(--mouse-y, 50%), rgba(255, 87, 34, 0.08), transparent 40%);
            pointer-events: none;
        }

        .card:hover {
            transform: translateY(-8px) scale(1.01);
            border-color: var(--accent-orange);
            box-shadow: 0 10px 25px rgba(255, 87, 34, 0.15);
        }

        .card-icon {
            font-size: 2rem;
            color: var(--accent-orange);
            margin-bottom: 18px;
        }

        /* Skills Category */
        .skill-list {
            list-style: none;
            margin-top: 10px;
        }

        .skill-list li {
            color: var(--text-secondary);
            font-size: 0.95rem;
            margin-bottom: 10px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .skill-list li::before {
            content: "✦";
            color: var(--accent-orange);
            font-size: 0.8rem;
        }

        /* Tables */
        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 20px;
            background: var(--card-bg);
            border-radius: 12px;
            overflow: hidden;
            border: 1px solid var(--border-color);
        }

        th, td {
            padding: 16px 20px;
            text-align: left;
            border-bottom: 1px solid var(--border-color);
            font-size: 0.95rem;
        }

        th {
            background: var(--table-header-bg);
            color: var(--accent-orange);
            font-weight: 600;
        }

        td {
            color: var(--text-secondary);
        }

        tr:hover td {
            background: rgba(255, 87, 34, 0.03);
            color: var(--text-main);
        }

        /* Dashboards & Metrics */
        .metric-card {
            background: var(--card-bg);
            padding: 25px;
            border-radius: 12px;
            text-align: center;
            border: 1px solid var(--border-color);
            transition: 0.3s;
        }

        .metric-card:hover {
            border-color: var(--accent-orange);
            transform: translateY(-4px);
        }

        .metric-card .value {
            font-size: 2.2rem;
            font-weight: 800;
            color: var(--accent-orange);
            margin-bottom: 5px;
        }

        .metric-card .label {
            font-size: 0.9rem;
            color: var(--text-secondary);
        }

        /* Contact Section */
        .contact-box {
            background: var(--card-bg);
            border: 1px solid var(--card-border);
            padding: 50px;
            border-radius: 18px;
            text-align: center;
            max-width: 650px;
            margin: auto;
            backdrop-filter: blur(10px);
            box-shadow: 0 15px 35px rgba(0,0,0,0.1);
        }

        .contact-box h3 {
            font-size: 2rem;
            margin-bottom: 15px;
        }

        .contact-info {
            display: flex;
            flex-direction: column;
            gap: 18px;
            margin-top: 30px;
        }

        .contact-item {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 12px;
            color: var(--text-secondary);
            font-size: 1.05rem;
        }

        /* Buttons */
        .btn {
            display: inline-block;
            background: linear-gradient(135deg, var(--accent-orange), var(--accent-glow));
            color: #fff;
            padding: 14px 32px;
            border-radius: 30px;
            font-weight: 600;
            margin-top: 15px;
            box-shadow: 0 5px 20px rgba(255, 87, 34, 0.3);
            transition: all 0.3s ease;
        }

        .btn:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 25px rgba(255, 87, 34, 0.5);
            opacity: 1;
        }

        /* Responsive Design */
        @media (max-width: 992px) {
            .grid-4 { grid-template-columns: repeat(2, 1fr); }
            .grid-3 { grid-template-columns: repeat(2, 1fr); }
        }

        @media (max-width: 768px) {
            .hero-grid, .grid-2, .grid-3, .grid-4 {
                grid-template-columns: 1fr;
            }
            .nav-links { display: none; }
            .hero-text h1 { font-size: 2.8rem; }
            .container { padding: 50px 0; }
        }
    </style>
</head>
