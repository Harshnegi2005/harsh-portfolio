    <div class="hero-visual reveal">
      <div class="floating-tag tag-one"><span>+140%</span>SEO Traffic Growth</div>
      <div class="profile-card">
        <img src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=800&auto=format&fit=crop&q=80" alt="Harsh Negi Profile">
      </div>
      <div class="floating-tag tag-two"><span>3.8x</span>Meta & Google Ads ROAS</div>
    </div>
  </div>
</section>

<!-- About Section -->
<section id="about">
  <div class="container">
    <div class="section-head reveal">
      <div class="section-kicker">About Me</div>
      <h2 class="section-title">Data-driven strategy, creative execution.</h2>
      <p class="section-desc">A structured approach to search positioning, campaign architecture, and audience growth.</p>
    </div>

    <div class="about-grid">
      <div class="about-box reveal">
        <h3>Focused on measurable growth & organic dominance.</h3>
      </div>
