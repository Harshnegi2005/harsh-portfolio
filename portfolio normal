<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="description" content="Harsh Negi — Digital Marketing Professional specializing in SEO, Content Marketing, Paid Ads & Growth Strategy.">
<title>Harsh Negi | Digital Marketing Portfolio</title>

<!-- Fonts -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Playfair+Display:ital,wght@0,600;0,700;1,400&display=swap" rel="stylesheet">

<style>
:root {
  --bg: #f8fafc;
  --surface: #ffffff;
  --text: #0f172a;
  --muted: #64748b;
  --line: #e2e8f0;
  --orange: #f97316;
  --orange-dark: #ea580c;
  --navy: #0b192c;
  --navy-light: #1e293b;
  --soft: #fff7ed;
  --shadow: 0 18px 50px rgba(15,23,42,.08);
  --shadow-lg: 0 25px 50px -12px rgba(15,23,42,.25);
  --radius: 22px;
  --max: 1180px;
}

* { margin: 0; padding: 0; box-sizing: border-box; scroll-behavior: smooth; }
html { scroll-padding-top: 90px; }
body {
  font-family: "DM Sans", sans-serif;
  color: var(--text);
  background:
    radial-gradient(circle at 10% 10%, rgba(249,115,22,.08), transparent 25%),
    radial-gradient(circle at 90% 30%, rgba(11,25,44,.05), transparent 28%),
    var(--bg);
  line-height: 1.6;
  overflow-x: hidden;
}

a { text-decoration: none; color: inherit; }
.container { width: min(var(--max), 92%); margin: auto; }

/* Navigation */
header {
  position: fixed; top: 0; left: 0; width: 100%; z-index: 1000;
  background: rgba(255, 255, 255, 0.88);
  backdrop-filter: blur(18px);
  border-bottom: 1px solid rgba(226, 232, 240, 0.8);
}
.navbar {
  min-height: 76px; display: flex; align-items: center; justify-content: space-between;
}
.logo { font-family: "Playfair Display", serif; font-size: 1.6rem; font-weight: 700; color: var(--navy); }
.logo span { color: var(--orange); }
.nav-links { display: flex; gap: 30px; list-style: none; }
.nav-links a { font-size: 0.95rem; font-weight: 600; color: #475569; position: relative; transition: color 0.2s; }
.nav-links a::after {
  content: ""; position: absolute; left: 0; bottom: -6px; width: 0; height: 2px;
  background: var(--orange); transition: 0.3s;
}
.nav-links a:hover { color: var(--orange); }
.nav-links a:hover::after { width: 100%; }
.menu-btn {
  display: none; border: 0; background: var(--navy); color: white;
  width: 42px; height: 42px; border-radius: 12px; font-size: 20px; cursor: pointer;
}

/* Hero Section */
.hero { min-height: 100vh; padding: 145px 0 80px; display: flex; align-items: center; }
.hero-grid { display: grid; grid-template-columns: 1.08fr 0.92fr; gap: 60px; align-items: center; }
.eyebrow {
  display: inline-flex; align-items: center; gap: 8px;
  padding: 8px 16px; border: 1px solid #fed7aa; background: var(--soft);
  color: var(--orange-dark); border-radius: 999px; font-size: 0.82rem; font-weight: 700;
  margin-bottom: 20px;
}
.eyebrow i { width: 8px; height: 8px; background: var(--orange); border-radius: 50%; display: block; }
h1 {
  font-family: "Playfair Display", serif;
  font-size: clamp(3.1rem, 6.5vw, 5.6rem);
  line-height: 1.02; letter-spacing: -.03em; margin-bottom: 18px; color: var(--navy);
}
h1 em { color: var(--orange); font-style: normal; }
.hero-role { font-size: clamp(1.15rem, 2vw, 1.5rem); font-weight: 700; margin-bottom: 18px; color: #334155; }
.hero-role span { color: var(--orange); margin: 0 4px; }
.hero-copy { max-width: 620px; color: var(--muted); font-size: 1.05rem; margin-bottom: 30px; }
.buttons { display: flex; gap: 14px; flex-wrap: wrap; }
.btn {
  display: inline-flex; align-items: center; justify-content: center; gap: 9px;
  padding: 13px 24px; border-radius: 12px; font-weight: 700; transition: 0.25s;
  border: 1px solid transparent; cursor: pointer; font-size: 0.95rem;
}
.btn-primary { background: var(--navy); color: white; box-shadow: 0 10px 25px rgba(11,25,44,.15); }
.btn-primary:hover { background: var(--orange); transform: translateY(-3px); }
.btn-light { background: white; border-color: var(--line); color: var(--text); }
.btn-light:hover { border-color: var(--orange); color: var(--orange); transform: translateY(-3px); }

/* Profile Card Visual */
.hero-visual { position: relative; display: flex; justify-content: center; }
.profile-card {
  width: min(380px, 82vw); aspect-ratio: 4/5; background: var(--navy);
  border-radius: 32px; position: relative; overflow: hidden; box-shadow: var(--shadow);
  transform: rotate(2deg); transition: 0.4s;
}
.profile-card:hover { transform: rotate(0) translateY(-7px); }
.profile-card::before {
  content: ""; position: absolute; width: 250px; height: 250px; border-radius: 50%;
  background: var(--orange); right: -80px; top: -70px; opacity: .85;
}
.profile-card img { width: 100%; height: 100%; object-fit: cover; position: relative; z-index: 2; }
.floating-tag {
  position: absolute; z-index: 5; background: white; border-radius: 16px; padding: 12px 18px;
  box-shadow: var(--shadow); font-size: 0.8rem; font-weight: 800; border: 1px solid var(--line);
}
.tag-one { left: -30px; top: 18%; }
.tag-two { right: -25px; bottom: 17%; }
.floating-tag span { display: block; color: var(--orange); font-size: 1.1rem; }

/* Section Headers */
section { padding: 95px 0; }
.section-head { text-align: center; max-width: 720px; margin: 0 auto 50px; }
.section-kicker { color: var(--orange); font-size: 0.82rem; text-transform: uppercase; letter-spacing: 0.16em; font-weight: 800; }
.section-title { font-family: "Playfair Display", serif; font-size: clamp(2.2rem, 4vw, 3.4rem); line-height: 1.15; margin: 8px 0 14px; color: var(--navy); }
.section-desc { color: var(--muted); font-size: 1.02rem; }

/* About Section */
.about-grid { display: grid; grid-template-columns: 0.85fr 1.15fr; gap: 50px; align-items: start; }
.about-box {
  background: var(--navy); color: white; border-radius: var(--radius); padding: 40px; position: relative; overflow: hidden;
}
.about-box::after { content: ""; position: absolute; width: 170px; height: 170px; border-radius: 50%; background: var(--orange); right: -65px; bottom: -65px; opacity: 0.9; }
.about-box h3 { font-family: "Playfair Display", serif; font-size: 2.1rem; line-height: 1.25; position: relative; z-index: 2; }
.about-content p { color: var(--muted); margin-bottom: 18px; font-size: 1.02rem; }
.stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; margin-top: 28px; }
.stat { background: #fff; border: 1px solid var(--line); border-radius: 16px; padding: 18px 12px; text-align: center; }
.stat strong { display: block; font-size: 1.4rem; color: var(--orange); }
.stat small { color: var(--muted); font-size: 0.82rem; font-weight: 600; }

.skills { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 24px; }
.skill { padding: 8px 15px; border-radius: 999px; background: #fff; border: 1px solid var(--line); font-size: 0.86rem; font-weight: 600; transition: all 0.2s; }
.skill:hover { border-color: #fdba74; background: var(--soft); transform: translateY(-2px); }

/* Services Section */
.services-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
.service-card {
  background: rgba(255,255,255,0.9); border: 1px solid var(--line); border-radius: var(--radius);
  padding: 32px 28px; transition: 0.3s; position: relative; overflow: hidden;
}
.service-card::before { content: ""; position: absolute; left: 0; top: 0; width: 100%; height: 3px; background: var(--orange); transform: scaleX(0); transform-origin: left; transition: 0.3s; }
.service-card:hover { transform: translateY(-8px); box-shadow: var(--shadow); border-color: #fed7aa; }
.service-card:hover::before { transform: scaleX(1); }
.icon {
  width: 50px; height: 50px; border-radius: 14px; background: var(--soft); display: grid; place-items: center;
  font-size: 22px; margin-bottom: 20px; color: var(--orange-dark); font-weight: 700;
}
.service-card h3 { margin-bottom: 10px; font-size: 1.2rem; color: var(--navy); }
.service-card p { color: var(--muted); font-size: 0.94rem; }

/* Projects Section */
.projects { display: grid; grid-template-columns: repeat(2, 1fr); gap: 24px; }
.project {
  min-height: 290px; border-radius: var(--radius); padding: 32px; background: linear-gradient(135deg,#0b192c,#1e293b);
  color: white; position: relative; overflow: hidden; display: flex; flex-direction: column; justify-content: flex-end;
  cursor: pointer; transition: transform 0.3s, box-shadow 0.3s; box-shadow: 0 10px 30px rgba(0,0,0,0.12);
}
.project:hover { transform: translateY(-6px); box-shadow: 0 20px 45px rgba(11,25,44,0.35); }
.project:nth-child(2) { background: linear-gradient(135deg,#9a3412,#ea580c); }
.project:nth-child(3) { background: linear-gradient(135deg,#0f172a,#334155); }
.project:nth-child(4) { background: linear-gradient(135deg,#7c2d12,#f97316); }

.project-thumb-preview {
  width: 100%; height: 100%; position: absolute; top: 0; left: 0; object-fit: cover; opacity: 0.22;
  transition: opacity 0.3s, transform 0.3s; pointer-events: none;
}
.project:hover .project-thumb-preview { opacity: 0.38; transform: scale(1.04); }
.image-count-badge {
  position: absolute; top: 22px; right: 22px; font-size: 0.78rem; background: rgba(0,0,0,0.45);
  backdrop-filter: blur(8px); padding: 6px 14px; border-radius: 20px; border: 1px solid rgba(255,255,255,0.25);
  font-weight: 700; display: flex; align-items: center; gap: 6px; color: #fff; z-index: 3;
}
.project-label { font-size: 0.76rem; text-transform: uppercase; letter-spacing: 0.14em; opacity: 0.85; font-weight: 700; position: relative; z-index: 2; }
.project h3 { font-family: "Playfair Display", serif; font-size: 1.85rem; margin: 6px 0; position: relative; z-index: 2; }
.project p { opacity: 0.88; font-size: 0.93rem; max-width: 440px; position: relative; z-index: 2; line-height: 1.5; }

/* Modal Styles */
.modal-overlay {
  position: fixed; top: 0; left: 0; width: 100%; height: 100%;
  background: rgba(11, 25, 44, 0.82); backdrop-filter: blur(10px);
  z-index: 2000; display: flex; align-items: center; justify-content: center;
  opacity: 0; pointer-events: none; transition: opacity 0.3s ease; padding: 20px;
}
.modal-overlay.active { opacity: 1; pointer-events: auto; }
.modal-container {
  background: var(--surface); width: min(880px, 94vw); max-height: 88vh;
  border-radius: 28px; padding: 36px; position: relative; overflow-y: auto;
  box-shadow: var(--shadow-lg); transform: scale(0.95); transition: transform 0.3s ease;
}
.modal-overlay.active .modal-container { transform: scale(1); }
.close-modal {
  position: absolute; top: 20px; right: 20px; width: 38px; height: 38px;
  border-radius: 50%; background: #f1f5f9; border: none; font-size: 1.3rem;
  cursor: pointer; display: grid; place-items: center; color: var(--navy); transition: all 0.2s; z-index: 10;
}
.close-modal:hover { background: #e2e8f0; transform: rotate(90deg); }

.modal-tag { display: inline-block; padding: 4px 14px; background: var(--soft); color: var(--orange-dark); font-weight: 700; font-size: 0.8rem; border-radius: 20px; margin-bottom: 10px; }
.modal-title { font-family: "Playfair Display", serif; font-size: 2.1rem; color: var(--navy); margin-bottom: 8px; line-height: 1.2; }
.modal-desc { color: var(--muted); font-size: 0.98rem; margin-bottom: 26px; }

/* Upload Box */
.image-upload-zone {
  border: 2px dashed #cbd5e1; border-radius: 20px; padding: 30px;
  text-align: center; background: #f8fafc; cursor: pointer; transition: all 0.25s;
  margin-bottom: 28px;
}
.image-upload-zone:hover, .image-upload-zone.dragover { border-color: var(--orange); background: var(--soft); }
.image-upload-zone input { display: none; }

/* Gallery Inside Modal */
.gallery-section-header {
  display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;
  border-bottom: 2px solid var(--line); padding-bottom: 10px;
}
.gallery-section-header h4 { font-size: 1.1rem; color: var(--navy); font-weight: 700; }
.gallery-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 20px; }

.gallery-card {
  background: #ffffff; border: 1px solid var(--line); border-radius: 16px;
  overflow: hidden; box-shadow: 0 4px 15px rgba(0,0,0,0.04); display: flex; flex-direction: column; transition: transform 0.2s, box-shadow 0.2s;
}
.gallery-card:hover { transform: translateY(-3px); box-shadow: 0 10px 25px rgba(0,0,0,0.08); }
.gallery-img-wrapper { position: relative; width: 100%; height: 150px; background: #0b192c; overflow: hidden; cursor: pointer; }
.gallery-img-wrapper img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.3s; }
.gallery-img-wrapper:hover img { transform: scale(1.05); }
.gallery-img-overlay {
  position: absolute; inset: 0; background: rgba(11,25,44,0.45); display: grid; place-items: center;
  color: white; opacity: 0; transition: opacity 0.2s; font-size: 0.85rem; font-weight: 700;
}
.gallery-img-wrapper:hover .gallery-img-overlay { opacity: 1; }

.gallery-card-body { padding: 14px; display: flex; flex-direction: column; gap: 8px; flex-grow: 1; }
.gallery-input, .gallery-textarea {
  width: 100%; border: 1px solid var(--line); border-radius: 8px; padding: 8px 10px;
  font-size: 0.85rem; font-family: inherit; outline: none; background: #f8fafc; transition: border-color 0.2s;
}
.gallery-input:focus, .gallery-textarea:focus { border-color: var(--orange); background: #fff; }
.gallery-textarea { resize: vertical; min-height: 55px; }

.gallery-card-actions { display: flex; justify-content: space-between; align-items: center; margin-top: auto; padding-top: 6px; }
.btn-save-img {
  background: var(--navy); color: white; border: none; padding: 6px 14px; border-radius: 8px;
  font-size: 0.78rem; font-weight: 700; cursor: pointer; transition: background 0.2s;
}
.btn-save-img:hover { background: var(--orange); }
.btn-delete-img {
  background: transparent; color: #ef4444; border: none; padding: 6px;
  font-size: 0.82rem; font-weight: 600; cursor: pointer; border-radius: 6px;
}
.btn-delete-img:hover { background: #fee2e2; }

/* Lightbox Overlay */
.lightbox-overlay {
  position: fixed; top: 0; left: 0; width: 100%; height: 100%;
  background: rgba(11,25,44,0.94); backdrop-filter: blur(12px);
  z-index: 3000; display: flex; flex-direction: column; align-items: center; justify-content: center;
  opacity: 0; pointer-events: none; transition: opacity 0.3s ease; padding: 24px;
}
.lightbox-overlay.active { opacity: 1; pointer-events: auto; }
.lightbox-content { max-width: 900px; width: 100%; display: flex; flex-direction: column; align-items: center; }
.lightbox-img-wrap {
  max-height: 65vh; width: 100%; display: flex; justify-content: center; align-items: center;
  margin-bottom: 20px; border-radius: 18px; overflow: hidden; box-shadow: 0 25px 60px rgba(0,0,0,0.5); background: #000;
}
.lightbox-img-wrap img { max-height: 65vh; max-width: 100%; object-fit: contain; }
.lightbox-details { text-align: center; color: white; max-width: 700px; }
.lightbox-details h3 { font-family: "Playfair Display", serif; font-size: 1.8rem; margin-bottom: 8px; color: #fff; }
.lightbox-details p { color: #cbd5e1; font-size: 0.98rem; line-height: 1.6; }
.lightbox-close {
  position: absolute; top: 25px; right: 25px; background: rgba(255,255,255,0.15);
  border: none; color: white; width: 44px; height: 44px; border-radius: 50%;
  font-size: 1.5rem; cursor: pointer; display: grid; place-items: center; transition: background 0.2s;
}
.lightbox-close:hover { background: var(--orange); }

/* Contact Section */
.contact-wrap {
  background: var(--navy); color: white; border-radius: 30px; padding: 55px;
  display: grid; grid-template-columns: 1fr 1fr; gap: 50px; overflow: hidden; position: relative;
}
.contact-wrap::before { content: ""; position: absolute; width: 330px; height: 330px; border-radius: 50%; background: var(--orange); right: -170px; top: -170px; opacity: 0.85; }
.contact-wrap h2 { font-family: "Playfair Display", serif; font-size: clamp(2.2rem, 4vw, 3.5rem); line-height: 1.1; margin: 10px 0 15px; position: relative; z-index: 2; }
.contact-wrap p { color: #cbd5e1; position: relative; z-index: 2; }
.contact-details { margin-top: 30px; display: grid; gap: 14px; position: relative; z-index: 2; }
.contact-details a { color: #fff; font-weight: 600; display: inline-flex; align-items: center; gap: 8px; }
.contact-details a:hover { color: #fdba74; }

form { position: relative; z-index: 2; }
.field { margin-bottom: 16px; }
.field label { display: block; font-size: 0.82rem; font-weight: 600; margin-bottom: 6px; color: #e2e8f0; }
.field input, .field textarea {
  width: 100%; border: 1px solid rgba(255,255,255,0.16); background: rgba(255,255,255,0.08);
  color: white; border-radius: 12px; padding: 13px 14px; font: inherit; outline: none; transition: border-color 0.2s;
}
.field input::placeholder, .field textarea::placeholder { color: #94a3b8; }
.field input:focus, .field textarea:focus { border-color: #fb923c; box-shadow: 0 0 0 3px rgba(249,115,22,0.18); }
form .btn { width: 100%; background: var(--orange); color: white; cursor: pointer; }
form .btn:hover { background: var(--orange-dark); transform: translateY(-2px); }

/* Footer */
footer { padding: 28px 0; border-top: 1px solid var(--line); color: var(--muted); font-size: 0.88rem; }
.footer-row { display: flex; justify-content: space-between; gap: 20px; align-items: center; }
.footer-row strong { color: var(--text); }

/* Scroll Reveal */
.reveal { opacity: 0; transform: translateY(28px); transition: opacity 0.7s ease, transform 0.7s ease; }
.reveal.show { opacity: 1; transform: none; }

/* Custom Cursor Trail */
.cursor-bubble {
  position: fixed; left: 0; top: 0; width: 16px; height: 16px; border-radius: 50%; pointer-events: none;
  z-index: 9999; transform: translate(-50%,-50%);
  background: radial-gradient(circle at 30% 30%, rgba(255,255,255,.95) 0%, rgba(249,115,22,.72) 42%, transparent 100%);
  border: 1px solid rgba(249,115,22,.35);
  box-shadow: 0 0 14px rgba(249,115,22,.22);
  animation: bubbleTrail .85s ease-out forwards;
}
@keyframes bubbleTrail {
  0% { opacity: .9; transform: translate(-50%,-50%) scale(.35); }
  100% { opacity: 0; transform: translate(calc(-50% + var(--dx)), calc(-50% + var(--dy))) scale(1.65); }
}
.cursor-dot {
  position: fixed; width: 8px; height: 8px; border-radius: 50%; pointer-events: none; z-index: 10000;
  background: #f97316; transform: translate(-50%,-50%); box-shadow: 0 0 12px rgba(249,115,22,.7);
}

@media(max-width:900px){
  .hero-grid, .about-grid, .contact-wrap { grid-template-columns: 1fr; }
  .hero { text-align: center; }
  .hero-copy { margin-inline: auto; }
  .buttons { justify-content: center; }
  .hero-visual { margin-top: 20px; }
  .services-grid { grid-template-columns: 1fr 1fr; }
}
@media(max-width:680px){
  .navbar { min-height: 68px; }
  .menu-btn { display: block; }
  .nav-links {
    position: absolute; top: 68px; left: 4%; right: 4%; display: none; flex-direction: column;
    gap: 0; background: white; border: 1px solid var(--line); border-radius: 16px; padding: 8px; box-shadow: var(--shadow);
  }
  .nav-links.open { display: flex; }
  .nav-links a { display: block; padding: 12px 13px; }
  .hero { padding-top: 120px; }
  section { padding: 75px 0; }
  .services-grid, .projects { grid-template-columns: 1fr; }
  .stats { grid-template-columns: 1fr; }
  .contact-wrap { padding: 32px 22px; border-radius: 22px; }
  .tag-one { left: 0; } .tag-two { right: 0; }
  .footer-row { flex-direction: column; text-align: center; }
  .gallery-grid { grid-template-columns: 1fr; }
  .cursor-bubble, .cursor-dot { display: none; }
}
</style>
</head>

<body>

<!-- Navigation Header -->
<header>
  <div class="container navbar">
    <a href="#home" class="logo">HN <span>/</span> Harsh Negi</a>
    <button class="menu-btn" aria-label="Toggle navigation">☰</button>
    <nav>
      <ul class="nav-links">
        <li><a href="#home">Home</a></li>
        <li><a href="#about">About</a></li>
        <li><a href="#services">Services</a></li>
        <li><a href="#projects">Projects & Proofs</a></li>
        <li><a href="#contact">Contact</a></li>
      </ul>
    </nav>
  </div>
</header>

<main id="home">
<!-- Hero Section -->
<section class="hero">
