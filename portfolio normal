<style>

/* =========================
   ROOT
========================= */

:root{
    --bg:#f8fafc;
    --white:#ffffff;
    --text:#0f172a;
    --muted:#64748b;
    --line:#e2e8f0;

    --orange:#f97316;
    --orange-dark:#ea580c;

    --navy:#0b192c;
    --navy-light:#1e293b;

    --soft:#fff7ed;

    --radius:22px;

    --shadow:0 18px 50px rgba(15,23,42,.08);
    --shadow-lg:0 25px 60px rgba(15,23,42,.22);

    --max:1180px;
}


/* =========================
   RESET
========================= */

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    scroll-behavior:smooth;
}

html{
    scroll-padding-top:90px;
}

body{
    font-family:"DM Sans",sans-serif;
    color:var(--text);
    background:
    radial-gradient(circle at 10% 10%,rgba(249,115,22,.08),transparent 25%),
    radial-gradient(circle at 90% 30%,rgba(11,25,44,.05),transparent 28%),
    var(--bg);

    line-height:1.6;
    overflow-x:hidden;
}

img{
    max-width:100%;
    display:block;
}

a{
    text-decoration:none;
    color:inherit;
}

button,
input,
textarea{
    font:inherit;
}

.container{
    width:min(var(--max),92%);
    margin:auto;
}


/* =========================
   NAVBAR
========================= */

header{
    position:fixed;
    top:0;
    left:0;
    width:100%;
    z-index:1000;

    background:rgba(255,255,255,.9);
    backdrop-filter:blur(18px);

    border-bottom:1px solid rgba(226,232,240,.8);
}

.navbar{
    min-height:76px;

    display:flex;
    align-items:center;
    justify-content:space-between;
}

.logo{
    font-family:"Playfair Display",serif;
    font-size:1.5rem;
    font-weight:700;
    color:var(--navy);
}

.logo span{
    color:var(--orange);
}

.nav-links{
    display:flex;
    gap:30px;
    list-style:none;
}

.nav-links a{
    color:#475569;
    font-size:.95rem;
    font-weight:600;
    position:relative;
}

.nav-links a::after{
    content:"";

    position:absolute;
    left:0;
    bottom:-6px;

    width:0;
    height:2px;

    background:var(--orange);

    transition:.3s;
}

.nav-links a:hover{
    color:var(--orange);
}

.nav-links a:hover::after{
    width:100%;
}

.menu-btn{
    display:none;

    width:42px;
    height:42px;

    border:0;
    border-radius:12px;

    background:var(--navy);
    color:#fff;

    cursor:pointer;
    font-size:20px;
}


/* =========================
   HERO
========================= */

.hero{
    min-height:100vh;

    padding:145px 0 80px;

    display:flex;
    align-items:center;
}

.hero-grid{
    display:grid;
    grid-template-columns:1.08fr .92fr;
    gap:60px;

    align-items:center;
}

.eyebrow{
    display:inline-flex;
    align-items:center;
    gap:8px;

    padding:8px 16px;

    border:1px solid #fed7aa;
    background:var(--soft);

    color:var(--orange-dark);

    border-radius:999px;

    font-size:.82rem;
    font-weight:700;

    margin-bottom:20px;
}

.eyebrow i{
    width:8px;
    height:8px;

    background:var(--orange);

    border-radius:50%;
}

h1{
    font-family:"Playfair Display",serif;

    font-size:clamp(3.1rem,6.5vw,5.6rem);

    line-height:1.02;

    letter-spacing:-.03em;

    margin-bottom:18px;

    color:var(--navy);
}

h1 em{
    color:var(--orange);
    font-style:normal;
}

.hero-role{
    font-size:clamp(1.1rem,2vw,1.5rem);
    font-weight:700;

    margin-bottom:18px;

    color:#334155;
}

.hero-role span{
    color:var(--orange);
    margin:0 5px;
}

.hero-copy{
    max-width:620px;

    color:var(--muted);

    font-size:1.05rem;

    margin-bottom:30px;
}

.buttons{
    display:flex;
    gap:14px;
    flex-wrap:wrap;
}

.btn{
    display:inline-flex;

    align-items:center;
    justify-content:center;

    gap:8px;

    padding:13px 24px;

    border-radius:12px;

    font-weight:700;

    transition:.25s;

    border:1px solid transparent;

    cursor:pointer;
}

.btn-primary{
    background:var(--navy);
    color:white;
}

.btn-primary:hover{
    background:var(--orange);
    transform:translateY(-3px);
}

.btn-light{
    background:white;
    border-color:var(--line);
}

.btn-light:hover{
    border-color:var(--orange);
    color:var(--orange);
    transform:translateY(-3px);
}


/* =========================
   HERO IMAGE
========================= */

.hero-visual{
    position:relative;
    display:flex;
    justify-content:center;
}

.profile-card{
    width:min(380px,82vw);

    aspect-ratio:4/5;

    background:var(--navy);

    border-radius:32px;

    position:relative;

    overflow:hidden;

    box-shadow:var(--shadow);

    transform:rotate(2deg);

    transition:.4s;
}

.profile-card:hover{
    transform:rotate(0) translateY(-7px);
}

.profile-card::before{
    content:"";

    position:absolute;

    width:250px;
    height:250px;

    border-radius:50%;

    background:var(--orange);

    right:-80px;
    top:-70px;

    opacity:.85;
}

.profile-card img{
    width:100%;
    height:100%;

    object-fit:cover;

    position:relative;

    z-index:2;
}

.floating-tag{
    position:absolute;

    z-index:5;

    background:white;

    border-radius:16px;

    padding:12px 18px;

    box-shadow:var(--shadow);

    font-size:.8rem;

    font-weight:800;

    border:1px solid var(--line);
}

.floating-tag span{
    display:block;

    color:var(--orange);

    font-size:1.1rem;
}

.tag-one{
    left:-30px;
    top:18%;
}

.tag-two{
    right:-25px;
    bottom:17%;
}


/* =========================
   SECTION
========================= */

section{
    padding:95px 0;
}

.section-head{
    text-align:center;

    max-width:720px;

    margin:0 auto 50px;
}

.section-kicker{
    color:var(--orange);

    font-size:.82rem;

    text-transform:uppercase;

    letter-spacing:.16em;

    font-weight:800;
}

.section-title{
    font-family:"Playfair Display",serif;

    font-size:clamp(2.2rem,4vw,3.4rem);

    line-height:1.15;

    margin:8px 0 14px;

    color:var(--navy);
}

.section-desc{
    color:var(--muted);
}


/* =========================
   ABOUT
========================= */

.about-grid{
    display:grid;

    grid-template-columns:.85fr 1.15fr;

    gap:50px;

    align-items:start;
}

.about-box{
    background:var(--navy);

    color:white;

    border-radius:var(--radius);

    padding:40px;

    position:relative;

    overflow:hidden;
}

.about-box::after{
    content:"";

    position:absolute;

    width:170px;
    height:170px;

    border-radius:50%;

    background:var(--orange);

    right:-65px;
    bottom:-65px;
}

.about-box h3{
    font-family:"Playfair Display",serif;

    font-size:2.1rem;

    line-height:1.25;

    position:relative;

    z-index:2;
}

.about-content p{
    color:var(--muted);

    margin-bottom:18px;

    font-size:1.02rem;
}

.stats{
    display:grid;

    grid-template-columns:repeat(3,1fr);

    gap:14px;

    margin-top:28px;
}

.stat{
    background:white;

    border:1px solid var(--line);

    border-radius:16px;

    padding:18px 12px;

    text-align:center;
}

.stat strong{
    display:block;

    font-size:1.4rem;

    color:var(--orange);
}

.stat small{
    color:var(--muted);

    font-size:.82rem;

    font-weight:600;
}

.skills{
    display:flex;

    flex-wrap:wrap;

    gap:10px;

    margin-top:24px;
}

.skill{
    padding:8px 15px;

    border-radius:999px;

    background:white;

    border:1px solid var(--line);

    font-size:.86rem;

    font-weight:600;

    transition:.2s;
}

.skill:hover{
    border-color:#fdba74;

    background:var(--soft);

    transform:translateY(-2px);
}


/* =========================
   SERVICES
========================= */

.services-grid{
    display:grid;

    grid-template-columns:repeat(3,1fr);

    gap:20px;
}

.service-card{
    background:rgba(255,255,255,.9);

    border:1px solid var(--line);

    border-radius:var(--radius);

    padding:32px 28px;

    transition:.3s;

    position:relative;

    overflow:hidden;
}

.service-card:hover{
    transform:translateY(-8px);

    box-shadow:var(--shadow);

    border-color:#fed7aa;
}

.icon{
    width:50px;
    height:50px;

    border-radius:14px;

    background:var(--soft);

    display:grid;

    place-items:center;

    font-size:22px;

    margin-bottom:20px;
}

.service-card h3{
    margin-bottom:10px;

    font-size:1.2rem;

    color:var(--navy);
}

.service-card p{
    color:var(--muted);

    font-size:.94rem;
}


/* =========================
   PROJECTS
========================= */

.projects{
    display:grid;

    grid-template-columns:repeat(2,1fr);

    gap:24px;
}

.project{
    min-height:300px;

    border-radius:var(--radius);

    padding:32px;

    background:linear-gradient(135deg,#0b192c,#1e293b);

    color:white;

    position:relative;

    overflow:hidden;

    display:flex;

    flex-direction:column;

    justify-content:flex-end;

    cursor:pointer;

    transition:.3s;
}

.project:hover{
    transform:translateY(-6px);

    box-shadow:0 20px 45px rgba(11,25,44,.3);
}

.project:nth-child(2){
    background:linear-gradient(135deg,#9a3412,#ea580c);
}

.project:nth-child(3){
    background:linear-gradient(135deg,#0f172a,#334155);
}

.project:nth-child(4){
    background:linear-gradient(135deg,#7c2d12,#f97316);
}

.project::before{
    content:"";

    position:absolute;

    inset:0;

    background:linear-gradient(
        to top,
        rgba(0,0,0,.75),
        transparent
    );

    z-index:1;
}

.project-image{
    position:absolute;

    inset:0;

    width:100%;
    height:100%;

    object-fit:cover;

    opacity:.35;

    transition:.3s;
}

.project:hover .project-image{
    opacity:.5;

    transform:scale(1.05);
}

.project-content{
    position:relative;

    z-index:2;
}

.project-label{
    font-size:.76rem;

    text-transform:uppercase;

    letter-spacing:.14em;

    font-weight:700;

    opacity:.9;
}

.project h3{
    font-family:"Playfair Display",serif;

    font-size:1.85rem;

    margin:6px 0;
}

.project p{
    opacity:.9;

    font-size:.93rem;

    max-width:500px;
}

.project-button{
    display:inline-flex;

    margin-top:18px;

    padding:9px 15px;

    border-radius:10px;

    background:rgba(255,255,255,.15);

    border:1px solid rgba(255,255,255,.25);

    color:white;

    font-size:.82rem;

    font-weight:700;
}


/* =========================
   PROJECT MODAL
========================= */

.modal{
    position:fixed;

    inset:0;

    background:rgba(11,25,44,.85);

    backdrop-filter:blur(12px);

    z-index:2000;

    display:flex;

    justify-content:center;

    align-items:center;

    padding:20px;

    opacity:0;

    pointer-events:none;

    transition:.3s;
}

.modal.active{
    opacity:1;

    pointer-events:auto;
}

.modal-box{
    width:min(1000px,95vw);

    max-height:90vh;

    overflow-y:auto;

    background:white;

    border-radius:28px;

    padding:35px;

    position:relative;

    transform:translateY(20px);

    transition:.3s;

    box-shadow:var(--shadow-lg);
}

.modal.active .modal-box{
    transform:translateY(0);
}

.modal-close{
    position:absolute;

    top:18px;
    right:18px;

    width:40px;
    height:40px;

    border:0;

    border-radius:50%;

    background:#f1f5f9;

    cursor:pointer;

    font-size:22px;

    z-index:5;
}

.modal-close:hover{
    background:var(--orange);

    color:white;
}

.modal-box h2{
    font-family:"Playfair Display",serif;

    font-size:2.2rem;

    color:var(--navy);

    margin-bottom:10px;
}

.modal-box > p{
    color:var(--muted);

    margin-bottom:30px;
}

.gallery{
    display:grid;

    grid-template-columns:repeat(2,1fr);

    gap:18px;
}

.gallery-item{
    border-radius:16px;

    overflow:hidden;

    background:#f8fafc;

    border:1px solid var(--line);

    cursor:pointer;
}

.gallery-item img{
    width:100%;

    height:240px;

    object-fit:cover;

    transition:.3s;
}

.gallery-item:hover img{
    transform:scale(1.04);
}

.gallery-info{
    padding:15px;
}

.gallery-info h4{
    color:var(--navy);

    margin-bottom:5px;
}

.gallery-info p{
    color:var(--muted);

    font-size:.88rem;
}


/* =========================
   CERTIFICATES
========================= */

.certificate-grid{
    display:grid;

    grid-template-columns:repeat(3,1fr);

    gap:20px;
}

.certificate{
    background:white;

    border:1px solid var(--line);

    border-radius:20px;

    overflow:hidden;

    transition:.3s;
}

.certificate:hover{
    transform:translateY(-7px);

    box-shadow:var(--shadow);
}

.certificate-preview{
    height:220px;

    background:#f1f5f9;

    display:flex;

    align-items:center;

    justify-content:center;

    overflow:hidden;
}

.certificate-preview img{
    width:100%;
    height:100%;

    object-fit:cover;
}

.certificate-body{
    padding:20px;
}

.certificate-body h3{
    color:var(--navy);

    margin-bottom:5px;
}

.certificate-body p{
    color:var(--muted);

    font-size:.88rem;

    margin-bottom:15px;
}

.certificate-buttons{
    display:flex;

    gap:8px;

    flex-wrap:wrap;
}

.small-btn{
    padding:9px 13px;

    border-radius:9px;

    border:1px solid var(--line);

    font-size:.8rem;

    font-weight:700;
}

.small-btn.primary{
    background:var(--navy);

    color:white;

    border-color:var(--navy);
}

.small-btn:hover{
    border-color:var(--orange);

    color:var(--orange);
}

.small-btn.primary:hover{
    background:var(--orange);

    color:white;
}


/* =========================
   RESUME
========================= */

.resume-box{
    background:var(--navy);

    color:white;

    border-radius:28px;

    padding:45px;

    display:flex;

    align-items:center;

    justify-content:space-between;

    gap:30px;
}

.resume-box h2{
    font-family:"Playfair Display",serif;

    font-size:2.5rem;

    margin-bottom:8px;
}

.resume-box p{
    color:#cbd5e1;
}

.resume-buttons{
    display:flex;

    gap:10px;

    flex-wrap:wrap;
}

.resume-buttons .btn{
    background:var(--orange);

    color:white;
}

.resume-buttons .btn:hover{
    background:white;

    color:var(--navy);
}


/* =========================
   CONTACT
========================= */

.contact-wrap{
    background:var(--navy);

    color:white;

    border-radius:30px;

    padding:55px;

    display:grid;

    grid-template-columns:1fr 1fr;

    gap:50px;
}

.contact-wrap h2{
    font-family:"Playfair Display",serif;

    font-size:clamp(2.2rem,4vw,3.5rem);

    line-height:1.1;

    margin:10px 0 15px;
}

.contact-wrap p{
    color:#cbd5e1;
}

.contact-details{
    margin-top:30px;

    display:grid;

    gap:14px;
}

.contact-details a{
    color:white;

    font-weight:600;
}

.contact-details a:hover{
    color:#fdba74;
}

.field{
    margin-bottom:16px;
}

.field label{
    display:block;

    font-size:.82rem;

    font-weight:600;

    margin-bottom:6px;
}

.field input,
.field textarea{
    width:100%;

    border:1px solid rgba(255,255,255,.16);

    background:rgba(255,255,255,.08);

    color:white;

    border-radius:12px;

    padding:13px 14px;

    outline:none;
}

.field input::placeholder,
.field textarea::placeholder{
    color:#94a3b8;
}

.field input:focus,
.field textarea:focus{
    border-color:#fb923c;
}

.contact-form-btn{
    width:100%;

    background:var(--orange);

    color:white;

    border:0;
}

.contact-form-btn:hover{
    background:var(--orange-dark);
}


/* =========================
   FOOTER
========================= */

footer{
    padding:28px 0;

    border-top:1px solid var(--line);

    color:var(--muted);

    font-size:.88rem;
}

.footer-row{
    display:flex;

    justify-content:space-between;

    align-items:center;

    gap:20px;
}

.footer-row strong{
    color:var(--text);
}


/* =========================
   LIGHTBOX
========================= */

.lightbox{
    position:fixed;

    inset:0;

    background:rgba(0,0,0,.92);

    z-index:5000;

    display:flex;

    align-items:center;

    justify-content:center;

    padding:25px;

    opacity:0;

    pointer-events:none;

    transition:.3s;
}

.lightbox.active{
    opacity:1;

    pointer-events:auto;
}

.lightbox img{
    max-width:95vw;

    max-height:85vh;

    object-fit:contain;

    border-radius:12px;
}

.lightbox-close{
    position:absolute;

    top:20px;
    right:25px;

    width:45px;
    height:45px;

    border:0;

    border-radius:50%;

    background:rgba(255,255,255,.15);

    color:white;

    font-size:25px;

    cursor:pointer;
}

.lightbox-close:hover{
    background:var(--orange);
}


/* =========================
   REVEAL
========================= */

.reveal{
    opacity:0;

    transform:translateY(25px);

    transition:.7s ease;
}

.reveal.show{
    opacity:1;

    transform:none;
}


/* =========================
   CURSOR
========================= */

.cursor-dot{
    position:fixed;

    width:8px;
    height:8px;

    border-radius:50%;

    background:var(--orange);

    pointer-events:none;

    z-index:9999;

    transform:translate(-50%,-50%);

    box-shadow:0 0 15px rgba(249,115,22,.7);
}

.cursor-bubble{
    position:fixed;

    width:14px;
    height:14px;

    border-radius:50%;

    pointer-events:none;

    z-index:9998;

    background:rgba(249,115,22,.35);

    border:1px solid rgba(249,115,22,.5);

    transform:translate(-50%,-50%);

    animation:bubble .8s ease-out forwards;
}

@keyframes bubble{

    0%{
        opacity:.8;
        transform:translate(-50%,-50%) scale(.4);
    }

    100%{
        opacity:0;
        transform:
        translate(
            calc(-50% + var(--dx)),
            calc(-50% + var(--dy))
        )
        scale(1.5);
    }
}


/* =========================
   RESPONSIVE
========================= */

@media(max-width:900px){

    .hero-grid,
    .about-grid,
    .contact-wrap{
        grid-template-columns:1fr;
    }

    .hero{
        text-align:center;
    }

    .hero-copy{
        margin:auto auto 30px;
    }

    .buttons{
        justify-content:center;
    }

    .hero-visual{
        margin-top:20px;
    }

    .services-grid{
        grid-template-columns:repeat(2,1fr);
    }

    .certificate-grid{
        grid-template-columns:repeat(2,1fr);
    }

    .resume-box{
        flex-direction:column;

        text-align:center;
    }
}


@media(max-width:680px){

    .navbar{
        min-height:68px;
    }

    .menu-btn{
        display:block;
    }

    .nav-links{
        position:absolute;

        top:68px;

        left:4%;
        right:4%;

        display:none;

        flex-direction:column;

        gap:0;

        background:white;

        border:1px solid var(--line);

        border-radius:16px;

        padding:8px;

        box-shadow:var(--shadow);
    }

    .nav-links.open{
        display:flex;
    }

    .nav-links a{
        display:block;

        padding:12px;
    }

    .hero{
        padding-top:120px;
    }

    section{
        padding:75px 0;
    }

    .services-grid,
    .projects,
